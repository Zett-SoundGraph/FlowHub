  "version": "0.2.0",
  "configurations": [
    {
      "name": "FlowHub (Default Debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": ["--no-enable-impeller"]
    },
    {
      "name": "FlowHub (Default Profile)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main.dart",
      "args": ["--no-enable-impeller"]
    },
    {
      "name": "FlowHub (Default Release)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "program": "lib/main.dart",
      "args": ["--no-enable-impeller"]
    },
    {
      "name": "FlowHub (Dev Debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main_dev.dart",
      "args": ["--flavor", "dev", "--no-enable-impeller", "--dart-define-from-file=env.json"]
    },
    {
      "name": "FlowHub (Dev Profile)",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "program": "lib/main_dev.dart",
